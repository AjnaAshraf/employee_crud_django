# api call for listing all employee

###
GET  http://127.0.0.1:8000/employees/
Accept: application/json


#api call for adding a employee record 

###
POST http://127.0.0.1:8000/employees/
Content-Type: application/json

{
    "name": "Sara",
    "department": "IT",
    "salary": 72000,
    "location": "Kochi",
    "email": "sara@gmail.com"
}

# api call for retrieving a employee detail

### 
GET http://127.0.0.1:8000/employees/1/
Accept: application/json


# api call for deleting a employee detail

### 
DELETE  http://127.0.0.1:8000/employees/2/
